{
  "name": "investor-browser",
  "version": "0.2.0",
  "description": "Desktop web browser for fundamental stock investors. Real browsing, local research, free official data.",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-main.mjs && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "author": "Investor Browser contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "productName": "Investor Browser",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "org.investorbrowser.app",
    "productName": "Investor Browser",
    "copyright": "Copyright © 2026 Investor Browser contributors",
    "asar": true,
    "files": [
      "dist/**",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "InvestorBrowser"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Investor Browser",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Investor-Browser-Setup-${version}-x64.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "artifactName": "Investor-Browser-${version}-x86_64.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/InversorIbex/INVESTOR_BROWSER.git"
  }
}
